{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workbench Governance Levels",
  "type": "object",
  "required": [
    "schema_version",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "workbench.governance.levels.v1"
    },
    "items": {
      "type": "array",
      "minItems": 2,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "base",
          "behavior",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{2,60}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "base": {
            "enum": [
              "mandatory",
              "ordinary"
            ]
          },
          "behavior": {
            "enum": [
              "block",
              "warn",
              "record"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "additionalProperties": false
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}
